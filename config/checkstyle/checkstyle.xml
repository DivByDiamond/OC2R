<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value="module\-info\.java$"/>
  </module>

  <module name="BeforeExecutionExclusionFileFilter">
    <property name="fileNamePattern" value=".*[/\\]jcodec[/\\].*"/>
  </module>

  <module name="SuppressWarningsFilter"/>

  <!--
    `MissingJavadocMethod` is only meaningful for the public API surface, so
    the check is enabled for the API packages (`api`, `manual/api` and
    `platform`) and muted for everything else.

    `SuppressionSingleFilter` matches its `files` pattern with `Matcher.find()`,
    i.e. the pattern may match at any offset of the path. The pattern below is
    therefore anchored with `^` and `$`, so that the negative lookahead is
    evaluated against the whole path: a path is only muted when it has no
    `api` or `platform` directory segment at all. Without the anchor the
    lookahead matches at the first offset that is outside such a segment, which
    mutes the check for the whole repository.
  -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="MissingJavadocMethod"/>
    <property name="files" value="^(?!.*[/\\](api|platform)[/\\]).*$"/>
  </module>

  <!--
    The API packages still hold members that were written before this check
    had any effect. They are muted one file and one line at a time, so that a
    public API member added from now on is reported while the existing ones
    stay as they are. The lines are the lines of the members themselves; the
    26.x trees are generated from the same sources and keep the same line
    numbers, except for the members that only exist in one of the versions.
