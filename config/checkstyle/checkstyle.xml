    <!-- SUPPRESSION -->
    <module name="SuppressWarningsHolder"/>
    <module name="SuppressionCommentFilter">
      <property name="offCommentFormat" value="CHECKSTYLE.OFF\: ([\w\|]+)"/>
      <property name="onCommentFormat" value="CHECKSTYLE.ON\: ([\w\|]+)"/>
      <property name="checkFormat" value="$1"/>
    </module>
    <module name="SuppressWithNearbyCommentFilter">
      <property name="commentFormat" value="CHECKSTYLE.SUPPRESS\: ([\w\|]+)"/>
      <property name="checkFormat" value="$1"/>
      <property name="influenceFormat" value="1"/>
    </module>

    <!--
      The multiversion source layout renames or moves the imported class itself:
      `net.minecraft.resources.ResourceLocation` becomes `net.minecraft.resources.Identifier`
      on 26.x, and `net.minecraft.Util` becomes `net.minecraft.util.Util`. The new name sorts
      to a different place than the old one, so an import that sits next to a neighbour whose
      position flips with it has no order that satisfies 1.21.1 and 26.x at the same time.

      The suppression is narrowed to the single import that Checkstyle reports, so
      CustomImportOrder keeps checking every other import of these files. The file pattern is
      bound to the source trees of this project (`src/main/java` and the generated Stonecutter
      trees), so a same-named file of another package cannot be silenced by accident.

      Note: the move of `net.minecraft.Util` to `net.minecraft.util.Util` is not a Stonecutter
      replacement (stonecutter.gradle.kts has four replacements, none of them touches Util);
      LinkSegment carries it as a conditional import.
    -->
    <module name="SuppressionXpathSingleFilter">
      <property name="checks" value="CustomImportOrder"/>
      <property name="files"
                value=".*[/\\](src[/\\]main[/\\]java|generated[/\\]stonecutter[/\\]main[/\\]java)[/\\].*[/\\](api[/\\]bus[/\\]device[/\\]DeviceType|api[/\\]util[/\\]Registries|manual[/\\]api[/\\]util[/\\]Constants|manual[/\\]client[/\\]util[/\\](ManualRegistry|RegistryUtils)|platform[/\\](BlockHolder|ItemHolder))\.java"/>
      <property name="query" value="//IMPORT[./DOT//IDENT[@text='Identifier']]"/>
    </module>
    <module name="SuppressionXpathSingleFilter">
      <property name="checks" value="CustomImportOrder"/>
      <property name="files"
                value=".*[/\\](src[/\\]main[/\\]java|generated[/\\]stonecutter[/\\]main[/\\]java)[/\\].*[/\\]manual[/\\]client[/\\]document[/\\]segment[/\\]LinkSegment\.java"/>
      <property name="query" value="//IMPORT[./DOT//IDENT[@text='Component']]"/>
    </module>

  </module>
</module>
