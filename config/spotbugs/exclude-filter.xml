<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Vendored third-party code (jcodec), kept out of analysis like PMD/checkstyle do. -->
    <Match>
        <Source name="~.*[/\\]jcodec[/\\].*" />
    </Match>
    <Match>
        <Class name="~li\.cil\.oc2\.jcodec\..*" />
    </Match>
    <!-- Generated sources. -->
    <Match>
        <Source name="~.*[/\\]generated[/\\].*" />
    </Match>
    <!-- GameTest infrastructure (runs via runGameTestServer, not SpotBugs-linted). -->
    <Match>
        <Source name="~.*[/\\]gametest[/\\].*" />
    </Match>
    <Match>
        <Class name="~li\.cil\.oc2\.gametest\..*" />
    </Match>
    <!-- FrameState is a deliberately zero-copy read-only view of the terminal's buffer arrays,
         captured once per render frame under the geometry seqlock (§36 M4). EI_EXPOSE_REP{,2}
         on its accessors/constructor is the design, not a defect: cloning eight arrays per
         frame would defeat the capture's purpose, and the view is never mutated. -->
    <Match>
        <Class name="li.cil.oc2.common.vm.terminal.render.FrameState" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <Match>
        <Class name="li.cil.oc2.common.vm.terminal.render.FrameState" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <!-- scrollColFirst/scrollColLast (§44 DECSLRM) are plain ints written only from the single
         VM-output thread that drives the escape-sequence parser, same as the pre-existing
         scrollFirst/scrollLast (DECSTBM) they sit next to — client rendering reads the terminal
         buffers through the geometryVersion seqlock (§36 M4), not these fields directly. SpotBugs'
         AT_ heuristics flag the pair anyway once enough write sites exist (setWidth/resizeWidth/
         resizeHeight/CH6/DECSTR); scrollFirst/scrollLast stay under whatever count trips it. -->
    <Match>
        <Class name="li.cil.oc2.common.vm.terminal.Terminal" />
        <Field name="scrollColFirst" />
        <Bug pattern="AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE" />
    </Match>
    <Match>
        <Class name="li.cil.oc2.common.vm.terminal.Terminal" />
        <Field name="scrollColLast" />
        <Bug pattern="AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE" />
    </Match>
    <!-- IL sets scrollColFirst-adjacent state from outside Terminal, mirroring the existing
         DECSTBM handlers (CH1 sets scrollFirst/scrollLast the same way) — PA_PUBLIC_PRIMITIVE_
         ATTRIBUTE flags the field, not the call site, so this exclusion lives on Terminal too. -->
    <Match>
        <Class name="li.cil.oc2.common.vm.terminal.Terminal" />
        <Field name="scrollColFirst" />
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE" />
    </Match>
    <Match>
        <Class name="li.cil.oc2.common.vm.terminal.Terminal" />
        <Field name="scrollColLast" />
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE" />
    </Match>
</FindBugsFilter>
