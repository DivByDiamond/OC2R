{
  "multipart": [
    {   "when": {"facing": "north"},
        "apply": { "model": "oc2r:block/monitor" }
    },
    {   "when": {"facing": "south"},
        "apply": { "model": "oc2r:block/monitor", "y": 180 }
    },
    {   "when": {"facing": "west"},
        "apply": { "model": "oc2r:block/monitor", "y": 270 }
    },
    {   "when": {"facing": "east"},
        "apply": { "model": "oc2r:block/monitor", "y": 90 }
    }
  ]
}
