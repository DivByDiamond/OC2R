diff --git a/kernel/src/net/config.rs b/kernel/src/net/config.rs
new file mode 100644
index 0000000..219cc88
--- /dev/null
+++ b/kernel/src/net/config.rs
@@ -0,0 +1,206 @@
+//! Per-interface IPv4 configuration and longest-prefix routing.
+use super::lock::{net_lock, net_unlock};
+use crate::drivers::virtio_net;
+use onyx_core::errno::{Errno, KResult};
+
+pub const CONFIG_SIZE: usize = 32;
+#[derive(Clone, Copy)]
+pub struct Interface {
+    pub ip: [u8; 4],
+    pub gateway: [u8; 4],
+    pub mask: [u8; 4],
+    pub dns: [u8; 4],
+    pub enabled: bool,
+}
+const EMPTY: Interface = Interface { ip: [0;4], gateway: [0;4], mask: [0;4], dns: [0;4], enabled: false };
+static mut INTERFACES: [Interface; 8] = [EMPTY; 8];
+static mut DEFAULT: usize = 0;
+
+pub fn choose_route(dst: [u8; 4], interfaces: &[Interface], default: usize) -> Option<usize> {
+    let destination = u32::from_be_bytes(dst);
+    let direct = interfaces.iter().enumerate().filter(|(_, iface)| {
+        let mask = u32::from_be_bytes(iface.mask);
+        iface.enabled && mask != 0 && (u32::from_be_bytes(iface.ip) & mask) == (destination & mask)
+    }).max_by_key(|(_, iface)| u32::from_be_bytes(iface.mask).count_ones()).map(|(index, _)| index);
+    direct.or_else(|| interfaces.get(default).filter(|iface| iface.enabled && iface.gateway != [0;4]).map(|_| default))
+}
+
+pub fn validate(data: &[u8; CONFIG_SIZE]) -> KResult<()> {
+    let ip = &data[4..8];
+    let mask = u32::from_be_bytes(data[12..16].try_into().map_err(|_| Errno::Inval)?);
+    if ip[0] == 0 || ip[0] >= 224 || mask == 0 || mask.leading_ones() != mask.count_ones() {
+        return Err(Errno::Inval);
+    }
+    Ok(())
+}
+
+/// # Safety
+/// Boot-hart-only initialization after the first DHCP exchange.
+pub unsafe fn seed_boot_interface() {
+    // SAFETY: before secondary harts/processes run; all config buffers initialized.
+    unsafe {
+        if virtio_net::device_count() > 0 {
+            INTERFACES[virtio_net::active_device()] = Interface {
+                ip: super::G_IP, gateway: super::G_GW, mask: super::G_MASK, dns: super::G_DNS, enabled: true,
+            };
+            let _ = crate::srv::event::add_timer(10_000, heartbeat);
+        }
+    }
+}
+
+fn heartbeat() {
+    if virtio_net::present() {
+        // SAFETY: timer callback runs in kernel context, SIE clear; poll serializes IO.
+        unsafe { super::poll(); }
+    }
+}
+
+pub fn is_configured(index: usize) -> bool {
+    // SAFETY: callers hold net_lock or run during single-hart boot.
+    unsafe { index < 8 && INTERFACES[index].enabled }
+}
+
+/// # Safety
+/// Caller holds net_lock, excluding packet IO on another hart.
+pub unsafe fn activate(index: usize) -> KResult<()> {
+    // SAFETY: driver validates index; its array and config array have the same cap.
+    unsafe {
+        virtio_net::select_device(index)?;
+        if INTERFACES[index].enabled {
+            let iface = INTERFACES[index];
+            super::G_IP = iface.ip;
+            super::G_GW = iface.gateway;
+            super::G_MASK = iface.mask;
+            super::G_DNS = iface.dns;
+        }
+        Ok(())
+    }
+}
+
+/// Run a network operation in one interface's context, restoring the caller's.
+/// # Safety
+/// Kernel context with interrupts clear; operation must not reconfigure cards.
+pub unsafe fn with_interface<T>(index: usize, operation: impl FnOnce() -> KResult<T>) -> KResult<T> {
+    // SAFETY: recursive network lock serializes both context switches and IO.
+    unsafe {
+        net_lock();
+        let previous = virtio_net::active_device();
+        let result = match activate(index) { Ok(()) => operation(), Err(error) => Err(error) };
+        let _ = activate(previous);
+        net_unlock();
+        result
+    }
+}
+
+pub fn dns_server() -> [u8; 4] {
+    // SAFETY: the configured default interface is read under the network lock.
+    unsafe { net_lock(); let dns = INTERFACES[DEFAULT].dns; net_unlock(); dns }
+}
+
+pub fn route(dst: [u8; 4]) -> Option<usize> {
+    // SAFETY: called under net_lock; DHCP before configuration uses the first card.
+    unsafe {
+        if dst == [255;4] || !INTERFACES.iter().any(|iface| iface.enabled) {
+            return Some(virtio_net::active_device());
+        }
+        choose_route(dst, &INTERFACES, DEFAULT)
+    }
+}
+
+/// # Safety
+/// Privileged syscall; all packet IO is serialized while addresses change.
+pub unsafe fn apply(data: &[u8; CONFIG_SIZE]) -> KResult<()> {
+    validate(data)?;
+    let index = u32::from_le_bytes(data[..4].try_into().map_err(|_| Errno::Inval)?) as usize;
+    // SAFETY: bounded interface table, serialized by the recursive network lock.
+    unsafe {
+        net_lock();
+        if index >= virtio_net::device_count() || index >= 8 { net_unlock(); return Err(Errno::Inval); }
+        super::tcp::clear_interface(index);
+        super::udp::clear_interface(index);
+        super::eth::clear_arp_cache();
+        INTERFACES[index] = Interface {
+            ip: data[4..8].try_into().map_err(|_| Errno::Inval)?,
+            gateway: data[8..12].try_into().map_err(|_| Errno::Inval)?,
+            mask: data[12..16].try_into().map_err(|_| Errno::Inval)?,
+            dns: data[16..20].try_into().map_err(|_| Errno::Inval)?,
+            enabled: true,
+        };
+        if INTERFACES[index].gateway != [0;4] { DEFAULT = index; }
+        let result = activate(index);
+        net_unlock();
+        result
+    }
+}
+
+pub fn snapshot(index: Option<usize>) -> KResult<[u8; CONFIG_SIZE]> {
+    // SAFETY: all runtime config writers take the same lock; index checked.
+    unsafe {
+        net_lock();
+        let index = index.unwrap_or(virtio_net::active_device());
+        if index >= virtio_net::device_count() || index >= 8 { net_unlock(); return Err(Errno::Inval); }
+        let iface = INTERFACES[index];
+        let mut data = [0; CONFIG_SIZE];
+        data[..4].copy_from_slice(&(index as u32).to_le_bytes());
+        data[4..8].copy_from_slice(&iface.ip);
+        data[8..12].copy_from_slice(&iface.gateway);
+        data[12..16].copy_from_slice(&iface.mask);
+        data[16..20].copy_from_slice(&iface.dns);
+        data[20..26].copy_from_slice(&virtio_net::device_mac(index)?);
+        data[26] = u8::from(iface.enabled);
+        data[27] = DEFAULT as u8;
+        data[28..32].copy_from_slice(&(virtio_net::device_count() as u32).to_le_bytes());
+        net_unlock();
+        Ok(data)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn longest_prefix_lan_route_beats_internet_default() {
+        let interfaces = [
+            Interface { ip: [10, 0, 2, 15], gateway: [10, 0, 2, 2], mask: [255, 255, 255, 0], dns: [203,0,113,9], enabled: true },
+            Interface { ip: [192, 168, 50, 1], gateway: [0;4], mask: [255,255,255,0], dns: [0;4], enabled: true },
+        ];
+        assert_eq!(choose_route([192,168,50,2], &interfaces, 0), Some(1));
+        assert_eq!(choose_route([203,0,113,7], &interfaces, 0), Some(0));
+        assert_eq!(choose_route([10,0,2,2], &interfaces, 0), Some(0));
+        assert_eq!(choose_route([203,0,113,8], &interfaces, 1), None);
+    }
+
+    #[test]
+    fn udp_connect_without_route_releases_network_lock() {
+        // SAFETY: test takes the same global lock as runtime writers and restores config.
+        unsafe {
+            net_lock();
+            let saved = INTERFACES;
+            let default = DEFAULT;
+            INTERFACES = [EMPTY;8];
+            INTERFACES[0] = Interface {ip:[192,168,50,1],mask:[255,255,255,0],enabled:true,..EMPTY};
+            DEFAULT = 0;
+            let result = super::super::udp::udp_bind_connect([203,0,113,8],53);
+            let depth = super::super::lock::owned_depth();
+            INTERFACES = saved;
+            DEFAULT = default;
+            net_unlock();
+            assert_eq!(result, Err(Errno::Io));
+            assert_eq!(depth, 1);
+        }
+    }
+
+    #[test]
+    fn accepts_private_static_ip_and_contiguous_mask() {
+        let mut config = [0; CONFIG_SIZE];
+        config[4..8].copy_from_slice(&[192, 168, 50, 1]);
+        config[12..16].copy_from_slice(&[255, 255, 255, 0]);
+        assert!(validate(&config).is_ok());
+        config[12..16].copy_from_slice(&[255, 0, 255, 0]);
+        assert!(validate(&config).is_err());
+        config[12..16].copy_from_slice(&[255, 255, 255, 0]);
+        config[4] = 224;
+        assert!(validate(&config).is_err());
+    }
+}
diff --git a/kernel/src/net/ownership.rs b/kernel/src/net/ownership.rs
new file mode 100644
index 0000000..a3a0a06
--- /dev/null
+++ b/kernel/src/net/ownership.rs
@@ -0,0 +1,110 @@
+//! User-visible numeric socket IDs are process-owned capabilities. Check and
+//! operate under one NET lock, excluding close/reallocation between both steps.
+use onyx_core::errno::{Errno,KResult};
+use super::{lock::{net_lock,net_unlock},tcp,udp};
+fn serialized<T>(operation:impl FnOnce()->KResult<T>)->KResult<T> {
+    net_lock();let result=operation();net_unlock();result
+}
+pub fn tcp_connect(ip:[u8;4],port:u16,pid:u32)->KResult<usize> {
+    serialized(||unsafe {let id=tcp::tcp_connect(ip,port)?;tcp::conn::CONNS[id].as_mut().ok_or(Errno::Inval)?.owner_pid=pid;Ok(id)})
+}
+pub fn tcp<T>(id:usize,pid:u32,operation:impl FnOnce()->KResult<T>)->KResult<T> {
+    serialized(||unsafe {
+        match tcp::conn::CONNS.get(id).and_then(Option::as_ref) {
+            Some(socket) if socket.owner_pid==pid=>operation(),
+            Some(_)=>Err(Errno::Perm),None=>Err(Errno::Inval),
+        }
+    })
+}
+pub fn listen(port:u16,pid:u32)->KResult<usize> {
+    serialized(||unsafe {let id=tcp::listen::listen(port)?;tcp::listen::set_owner(id,pid);Ok(id)})
+}
+pub fn listener<T>(id:usize,pid:u32,operation:impl FnOnce()->KResult<T>)->KResult<T> {
+    serialized(||unsafe {match tcp::listen::owner(id) {
+        Some(owner) if owner==pid=>operation(),Some(_)=>Err(Errno::Perm),None=>Err(Errno::Inval),
+    }})
+}
+pub fn bind_udp(port:u16,pid:u32)->KResult<usize> {
+    serialized(||unsafe {let id=udp::udp_bind_any(port)?;udp::UDP_SOCKS[id].as_mut().ok_or(Errno::Inval)?.owner_pid=pid;Ok(id)})
+}
+pub fn udp<T>(id:usize,pid:u32,operation:impl FnOnce()->KResult<T>)->KResult<T> {
+    serialized(||unsafe {match udp::UDP_SOCKS.get(id).and_then(Option::as_ref) {
+        Some(socket) if socket.owner_pid==pid=>operation(),Some(_)=>Err(Errno::Perm),None=>Err(Errno::Inval),
+    }})
+}
+/// Called before process teardown takes process-list or runqueue locks.
+/// Bounded table cleanup does no packet IO, allocation or scheduler work.
+pub fn close_process(pid:u32) {
+    net_lock();
+    unsafe {
+        for id in 0..8 { if tcp::listen::owner(id)==Some(pid) {let _=tcp::listen::close(id);} }
+        for slot in tcp::conn::CONNS.iter_mut() {
+            if slot.as_ref().is_some_and(|s|s.owner_pid==pid) {
+                if let Some(socket)=slot.as_mut().filter(|s|s.state==3 || s.state==4) {
+                    socket.owner_pid=0; // Kernel retains bounded FIN/data retries after close.
+                } else {*slot=None;}
+            }
+        }
+        for slot in udp::UDP_SOCKS.iter_mut() {if slot.as_ref().is_some_and(|s|s.owner_pid==pid) {*slot=None;} }
+    }
+    net_unlock();
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn process_exit_releases_owned_ports_and_preserves_other_processes() {
+        unsafe {
+            net_lock();let saved=tcp::conn::CONNS;
+            let listener_id=listen(34570,41).unwrap();
+            let udp_id=bind_udp(34571,41).unwrap();
+            let mut own:tcp::conn::TcpConn=core::mem::zeroed();own.owner_pid=41;own.listener=usize::MAX;
+            let mut foreign=own;foreign.owner_pid=42;
+            tcp::conn::CONNS[0]=Some(own);tcp::conn::CONNS[1]=Some(foreign);
+            close_process(41);
+            assert!(tcp::conn::CONNS[0].is_none());
+            assert_eq!(tcp::conn::CONNS[1].unwrap().owner_pid,42);
+            assert_eq!(listener(listener_id,41,||Ok(1)),Err(Errno::Inval));
+            assert_eq!(udp(udp_id,41,||Ok(1)),Err(Errno::Inval));
+            let new_listener=listen(34570,42).unwrap();let new_udp=bind_udp(34571,42).unwrap();
+            tcp::listen::close(new_listener).unwrap();super::super::udp::udp_close(new_udp);
+            tcp::conn::CONNS=saved;net_unlock();
+        }
+    }
+    #[test]
+    fn accepted_connections_inherit_listener_process_owner() {
+        unsafe {
+            net_lock();let saved=tcp::conn::CONNS;
+            let id=listen(34569,41).unwrap();
+            tcp::listen::incoming_syn(34569,[192,168,50,2],40001,100,2048);
+            let cid=tcp::conn::CONNS.iter().position(|slot|slot.as_ref().is_some_and(|c|c.listener==id)).unwrap();
+            assert_eq!(tcp::conn::CONNS[cid].unwrap().owner_pid,41);
+            tcp::conn::CONNS[cid].as_mut().unwrap().state=2;
+            tcp::listen::established(cid,id);
+            assert_eq!(listener(id,42,||tcp::listen::accept(id)),Err(Errno::Perm));
+            assert_eq!(listener(id,41,||tcp::listen::accept(id)),Ok(cid));
+            assert_eq!(tcp(cid,42,||Ok(7)),Err(Errno::Perm));
+            assert_eq!(tcp(cid,41,||Ok(7)),Ok(7));
+            tcp::listen::close(id).unwrap();tcp::conn::CONNS=saved;net_unlock();
+        }
+    }
+    #[test]
+    fn sockets_and_listeners_reject_other_processes() {
+        let listener_id=listen(34567,41).unwrap();
+        assert_eq!(listener(listener_id,42,||Ok(7)),Err(Errno::Perm));
+        assert_eq!(listener(listener_id,41,||Ok(7)),Ok(7));
+        listener(listener_id,41,||tcp::listen::close(listener_id)).unwrap();
+        let udp_id=bind_udp(34568,41).unwrap();
+        assert_eq!(udp(udp_id,42,||Ok(7)),Err(Errno::Perm));
+        assert_eq!(udp(udp_id,41,||Ok(7)),Ok(7));
+        udp(udp_id,41,||{unsafe {super::super::udp::udp_close(udp_id)};Ok(())}).unwrap();
+        unsafe {
+            net_lock();let saved=tcp::conn::CONNS;
+            let mut connection:tcp::conn::TcpConn=core::mem::zeroed();connection.owner_pid=41;
+            tcp::conn::CONNS[0]=Some(connection);
+            assert_eq!(tcp(0,42,||Ok(7)),Err(Errno::Perm));
+            assert_eq!(tcp(0,41,||Ok(7)),Ok(7));
+            tcp::conn::CONNS=saved;net_unlock();
+        }
+    }
+}
diff --git a/kernel/src/net/ipv4.rs b/kernel/src/net/ipv4.rs
new file mode 100644
index 0000000..11c399f
--- /dev/null
+++ b/kernel/src/net/ipv4.rs
@@ -0,0 +1,69 @@
+//! Bounds/checksum validation shared by IPv4 protocol dispatch and host tests.
+use super::{checksum::checksum, eth::ETH_HLEN};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Packet {
+    pub header_len: usize,
+    pub total_len: usize,
+    pub protocol: u8,
+    pub source: [u8; 4],
+    pub destination: [u8; 4],
+}
+
+pub fn parse(frame: &[u8]) -> Option<Packet> {
+    let ip = frame.get(ETH_HLEN..)?;
+    if ip.len() < 20 || ip[0] >> 4 != 4 || ip[8] == 0 { return None; }
+    let header_len = usize::from(ip[0] & 15) * 4;
+    let total_len = usize::from(u16::from_be_bytes([ip[2], ip[3]]));
+    if header_len < 20 || total_len < header_len || total_len > ip.len() { return None; }
+    if checksum(ip.get(..header_len)?) != 0 { return None; }
+    // Fragment reassembly is deliberately unsupported: reject MF or a nonzero offset.
+    if u16::from_be_bytes([ip[6], ip[7]]) & 0x3fff != 0 { return None; }
+    Some(Packet {
+        header_len, total_len, protocol: ip[9],
+        source: ip[12..16].try_into().ok()?, destination: ip[16..20].try_into().ok()?,
+    })
+}
+
+pub fn echo_reply(request: &[u8]) -> Option<alloc::vec::Vec<u8>> {
+    if request.len() < 8 || request[0] != 8 || request[1] != 0 || checksum(request) != 0 { return None; }
+    let mut reply = request.to_vec();
+    reply[0] = 0;
+    reply[2..4].fill(0);
+    let sum = checksum(&reply);
+    reply[2..4].copy_from_slice(&sum.to_be_bytes());
+    Some(reply)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn packet() -> [u8; 42] {
+        let mut frame = [0u8; 42];
+        let ip = &mut frame[ETH_HLEN..];
+        ip[0] = 0x45; ip[2..4].copy_from_slice(&28u16.to_be_bytes()); ip[8] = 64; ip[9] = 1;
+        let sum = checksum(&ip[..20]); ip[10..12].copy_from_slice(&sum.to_be_bytes());
+        frame
+    }
+    #[test]
+    fn rejects_truncation_bad_header_checksum_and_fragments() {
+        let frame = packet();
+        assert!(parse(&frame).is_some());
+        assert!(parse(&frame[..41]).is_none());
+        let mut bad = frame; bad[ETH_HLEN+8] ^= 1; assert!(parse(&bad).is_none());
+        let mut fragment = frame; fragment[ETH_HLEN+6] = 0x20;
+        fragment[ETH_HLEN+10..ETH_HLEN+12].fill(0);
+        let sum = checksum(&fragment[ETH_HLEN..ETH_HLEN+20]);
+        fragment[ETH_HLEN+10..ETH_HLEN+12].copy_from_slice(&sum.to_be_bytes());
+        assert!(parse(&fragment).is_none());
+    }
+    #[test]
+    fn echo_reply_preserves_exact_payload_and_reverses_type() {
+        let mut request = alloc::vec![8,0,0,0,0x12,0x34,0,1,b'p',b'i',b'n',b'g'];
+        let sum = checksum(&request); request[2..4].copy_from_slice(&sum.to_be_bytes());
+        let reply = echo_reply(&request).expect("valid echo");
+        assert_eq!(reply.len(), request.len());
+        assert_eq!(reply[0],0); assert_eq!(&reply[4..],&request[4..]); assert_eq!(checksum(&reply),0);
+        request[8] ^= 1; assert!(echo_reply(&request).is_none());
+    }
+}
diff --git a/kernel/src/net/tcp/listen.rs b/kernel/src/net/tcp/listen.rs
new file mode 100644
index 0000000..14152e0
--- /dev/null
+++ b/kernel/src/net/tcp/listen.rs
@@ -0,0 +1,108 @@
+//! Bounded passive TCP listeners; accepted connections use the ordinary socket API.
+use super::{conn::{CONNS, TcpConn, BUF_SIZE, alloc_conn, alloc_local_port, send_tcp_seg}, state::{SYN,ACK}};
+use crate::net::lock::{net_lock,net_unlock};
+use onyx_core::errno::{Errno,KResult};
+const LISTENERS_MAX: usize = 8;
+const BACKLOG: usize = 4;
+#[derive(Clone,Copy)]
+struct Listener { owner_pid:u32, port:u16, queue:[usize;BACKLOG], first:usize, len:usize }
+static mut LISTENERS: [Option<Listener>;LISTENERS_MAX] = [None;LISTENERS_MAX];
+
+pub fn listen(port:u16) -> KResult<usize> {
+    if port == 0 { return Err(Errno::Inval); }
+    // SAFETY: all listener and socket operations are serialized by net_lock.
+    unsafe {
+        net_lock();
+        let result = if LISTENERS.iter().flatten().any(|l|l.port==port) { Err(Errno::Busy) }
+        else if let Some(index) = LISTENERS.iter().position(Option::is_none) {
+            LISTENERS[index] = Some(Listener{owner_pid:0,port,queue:[0;BACKLOG],first:0,len:0}); Ok(index)
+        } else { Err(Errno::Busy) };
+        net_unlock(); result
+    }
+}
+
+pub fn accept(index:usize) -> KResult<usize> {
+    // SAFETY: bounds checked; all listener and socket operations under net_lock.
+    unsafe {
+        net_lock();
+        let result = match LISTENERS.get_mut(index).and_then(Option::as_mut) {
+            Some(listener) if listener.len>0 => {
+                let cid=listener.queue[listener.first]; listener.first=(listener.first+1)%BACKLOG; listener.len-=1;
+                if let Some(connection)=CONNS[cid].as_mut().filter(|c|c.listener==index && (c.state==2 || c.state==7)) { connection.listener=usize::MAX; Ok(cid) } else { Err(Errno::NoEnt) }
+            },
+            Some(_) => Err(Errno::NoEnt), None => Err(Errno::Inval),
+        };
+        net_unlock(); result
+    }
+}
+
+pub fn close(index:usize) -> KResult<()> {
+    // SAFETY: bounds checked; accepted sockets have detached listener ownership.
+    unsafe {
+        net_lock();
+        let result=if index<LISTENERS_MAX && LISTENERS[index].is_some() {
+            LISTENERS[index]=None;
+            for slot in CONNS.iter_mut() { if slot.as_ref().is_some_and(|c|c.listener==index) { *slot=None; } }
+            Ok(())
+        } else { Err(Errno::Inval) };
+        net_unlock();result
+    }
+}
+
+/// # Safety
+/// RX context under net_lock, after checksum and packet bounds validation.
+pub(in crate::net) unsafe fn incoming_syn(port:u16, remote:[u8;4], remote_port:u16, seq:u32, window:u16) {
+    // SAFETY: all indices checked or allocated from bounded tables.
+    unsafe {
+        let Some(parent)=LISTENERS.iter().position(|l|l.as_ref().is_some_and(|l|l.port==port)) else {return;};
+        if CONNS.iter().flatten().filter(|c|c.listener==parent).count()>=BACKLOG {return;}
+        let Some(cid)=alloc_conn() else {return;};
+        let isn=u32::from(alloc_local_port()).wrapping_mul(65537).wrapping_add(seq);
+        let mut connection=TcpConn {
+            owner_pid:LISTENERS[parent].as_ref().map(|l|l.owner_pid).unwrap_or(0),
+            iface:crate::drivers::virtio_net::active_device(), listener:parent,
+            state:5,src_port:port,dst_ip:remote,dst_port:remote_port,
+            snd_una:isn,snd_nxt:isn.wrapping_add(1),rcv_nxt:seq.wrapping_add(1),
+            send_buf:[0;BUF_SIZE],send_len:0,recv_buf:[0;BUF_SIZE],recv_len:0,recv_head:0,
+            peer_fin:false,tw_deadline_us:super::conn::now_us()+5_000_000,last_tx_us:super::conn::now_us(),retries:0,peer_window:window,
+        };
+        CONNS[cid]=Some(connection);
+        connection.snd_nxt=isn;
+        send_tcp_seg(&connection,SYN|ACK,&[]);
+    }
+}
+
+/// # Safety
+/// Caller holds net_lock; invoked once after passive handshake completion.
+pub(in crate::net) unsafe fn established(cid:usize, parent:usize) {
+    // SAFETY: parent and cid validated; listener may have closed while SYN was pending.
+    unsafe {
+        if let Some(listener)=LISTENERS.get_mut(parent).and_then(Option::as_mut) {
+            if listener.len<BACKLOG {
+                listener.queue[(listener.first+listener.len)%BACKLOG]=cid;listener.len+=1;return;
+            }
+        }
+        CONNS[cid]=None;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn listeners_reject_conflicting_ports_and_accept_is_nonblocking() {
+        let index=listen(23456).expect("listen");
+        assert_eq!(listen(23456),Err(Errno::Busy));
+        assert_eq!(accept(index),Err(Errno::NoEnt));
+        close(index).expect("close");
+        assert_eq!(accept(index),Err(Errno::Inval));
+    }
+}
+
+// Caller holds NET lock, serializing claims/checks with listener reuse.
+pub(in crate::net) unsafe fn set_owner(index:usize,pid:u32) {
+    unsafe { if let Some(listener)=LISTENERS.get_mut(index).and_then(Option::as_mut) {listener.owner_pid=pid;} }
+}
+pub(in crate::net) unsafe fn owner(index:usize)->Option<u32> {
+    unsafe { LISTENERS.get(index).and_then(Option::as_ref).map(|l|l.owner_pid) }
+}
diff --git a/kernel/src/net/tcp/retry.rs b/kernel/src/net/tcp/retry.rs
new file mode 100644
index 0000000..1245284
--- /dev/null
+++ b/kernel/src/net/tcp/retry.rs
@@ -0,0 +1,52 @@
+//! Bounded retransmission plans; no unbounded retry loops or retained socket borrows.
+use super::{conn::{TcpConn,CONNS,send_tcp_seg},state::{SYN,ACK,FIN}};
+const RETRY_US:u64=1_000_000;
+const RETRIES:u8=5;
+#[derive(Debug,Clone,Copy,PartialEq,Eq)]
+pub(super) struct Plan {pub flags:u8,pub sequence:u32,pub length:usize}
+pub(super) fn plan(connection:&mut TcpConn,now:u64)->Option<Plan>{
+    let action=match connection.state{
+        1=>Plan{flags:SYN,sequence:connection.snd_una,length:0},
+        5=>Plan{flags:SYN|ACK,sequence:connection.snd_una,length:0},
+        2 | 7 if connection.send_len>0=>Plan{flags:0x18,sequence:connection.snd_una,length:connection.send_len.min(536)},
+        3 if connection.send_len>0=>Plan{flags:0x18,sequence:connection.snd_una,length:connection.send_len.min(536)},
+        3=>Plan{flags:FIN|ACK,sequence:connection.snd_nxt.wrapping_sub(1),length:0},
+        _=>return None,
+    };
+    if now.wrapping_sub(connection.last_tx_us)<RETRY_US{return None;}
+    if connection.retries>=RETRIES{connection.state=6;connection.tw_deadline_us=now+5_000_000;return None;}
+    connection.retries+=1;connection.last_tx_us=now;Some(action)
+}
+static mut RUNNING:bool=false;
+/// # Safety
+/// Caller holds net_lock; avoids recursively retrying while TX resolves ARP.
+pub(super) unsafe fn tick(now:u64){
+    // SAFETY: network lock serializes static/table access; copies before reentrant TX.
+    unsafe{
+        if RUNNING{return;}RUNNING=true;
+        for cid in 0..super::conn::MAX_CONNS{
+            if let Some(mut connection)=CONNS[cid]{
+                let action=plan(&mut connection,now);CONNS[cid]=Some(connection);
+                if let Some(action)=action{
+                    connection.snd_nxt=action.sequence;
+                    let _=send_tcp_seg(&connection,action.flags,&connection.send_buf[..action.length]);
+                }
+            }
+        }
+        RUNNING=false;
+    }
+}
+#[cfg(test)]
+mod tests{
+    use super::*;
+    #[test]
+    fn retransmits_only_unacknowledged_prefix_and_eventually_reports_failure(){
+        let mut connection=super::super::tests::test_conn();connection.state=2;
+        connection.snd_una=100;connection.snd_nxt=103;connection.send_len=3;
+        assert_eq!(plan(&mut connection,999_999),None);
+        for retry in 1..=5{
+            assert_eq!(plan(&mut connection,retry*RETRY_US),Some(Plan{flags:0x18,sequence:100,length:3}));
+        }
+        assert_eq!(plan(&mut connection,6*RETRY_US),None);assert_eq!(connection.state,6);
+    }
+}
diff --git a/kernel/src/net/udp/datagram.rs b/kernel/src/net/udp/datagram.rs
new file mode 100644
index 0000000..677860f
--- /dev/null
+++ b/kernel/src/net/udp/datagram.rs
@@ -0,0 +1,51 @@
+//! Bounded UDP datagram queue: packet boundaries and sender metadata survive RX.
+pub const QUEUE_BYTES: usize = 2048;
+const QUEUE_MESSAGES: usize = 8;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Peer { pub ip: [u8;4], pub port: u16, pub iface: u8 }
+const EMPTY_PEER: Peer = Peer { ip: [0;4], port: 0, iface: 0 };
+#[derive(Clone, Copy)]
+pub struct DatagramQueue {
+    bytes: [u8; QUEUE_BYTES], head: usize, used: usize,
+    lengths: [usize; QUEUE_MESSAGES], peers: [Peer; QUEUE_MESSAGES], first: usize, messages: usize,
+}
+impl DatagramQueue {
+    pub const EMPTY: Self = Self { bytes: [0;QUEUE_BYTES], head:0, used:0, lengths:[0;QUEUE_MESSAGES], peers:[EMPTY_PEER;QUEUE_MESSAGES], first:0, messages:0 };
+    pub fn push(&mut self, payload: &[u8], peer: Peer) -> bool {
+        if payload.len() > QUEUE_BYTES - self.used || self.messages == QUEUE_MESSAGES { return false; }
+        let tail = (self.head + self.used) % QUEUE_BYTES;
+        for (index, byte) in payload.iter().enumerate() { self.bytes[(tail+index)%QUEUE_BYTES] = *byte; }
+        let slot = (self.first+self.messages)%QUEUE_MESSAGES;
+        self.lengths[slot] = payload.len(); self.peers[slot] = peer;
+        self.used += payload.len(); self.messages += 1; true
+    }
+    pub fn pop(&mut self, target: &mut [u8]) -> Option<(usize, Peer)> {
+        if self.messages == 0 { return None; }
+        let length = self.lengths[self.first]; let n = length.min(target.len());
+        for (index, byte) in target[..n].iter_mut().enumerate() { *byte = self.bytes[(self.head+index)%QUEUE_BYTES]; }
+        let peer = self.peers[self.first];
+        self.head = (self.head+length)%QUEUE_BYTES; self.used -= length;
+        self.first = (self.first+1)%QUEUE_MESSAGES; self.messages -= 1;
+        Some((n,peer))
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn messages_do_not_merge_and_truncation_discards_only_one_datagram() {
+        let mut q = DatagramQueue::EMPTY; let p = Peer { ip:[192,168,50,2],port:123,iface:1 };
+        assert!(q.push(b"hello",p)); assert!(q.push(b"world",p));
+        let mut small = [0;2]; assert_eq!(q.pop(&mut small),Some((2,p))); assert_eq!(&small,b"he");
+        let mut out = [0;8]; assert_eq!(q.pop(&mut out),Some((5,p))); assert_eq!(&out[..5],b"world");
+        assert_eq!(q.pop(&mut out),None);
+    }
+    #[test]
+    fn empty_datagrams_and_full_queue_are_bounded() {
+        let mut q = DatagramQueue::EMPTY;
+        for _ in 0..8 { assert!(q.push(&[],EMPTY_PEER)); }
+        assert!(!q.push(b"overflow",EMPTY_PEER));
+        assert_eq!(q.pop(&mut []),Some((0,EMPTY_PEER)));
+        assert!(q.push(b"ok",EMPTY_PEER));
+    }
+}
diff --git a/kernel/src/syscall/net_admin_sys.rs b/kernel/src/syscall/net_admin_sys.rs
new file mode 100644
index 0000000..807d6a5
--- /dev/null
+++ b/kernel/src/syscall/net_admin_sys.rs
@@ -0,0 +1,96 @@
+//! Privileged static-IP/interface selection and bounded UDP demo operations.
+use super::handler::user_ptr_ok;
+use crate::{mm::vmm, net, proc};
+use onyx_core::errno::{Errno, KResult};
+
+unsafe fn copyin<const N: usize>(ptr: u64) -> KResult<[u8; N]> {
+    if !user_ptr_ok(ptr, N as u64) {
+        return Err(Errno::Inval);
+    }
+    let mut data = [0; N];
+    // SAFETY: helper validates each user page before copying into the sized array.
+    unsafe { vmm::copy_from_user(proc::current().root_pa, data.as_mut_ptr(), ptr, N)?; }
+    Ok(data)
+}
+
+unsafe fn copyout(ptr: u64, data: &[u8]) -> KResult<()> {
+    if !user_ptr_ok(ptr, data.len() as u64) {
+        return Err(Errno::Inval);
+    }
+    // SAFETY: helper validates writable user pages; source is a valid slice.
+    unsafe { vmm::copy_to_user(proc::current().root_pa, ptr, data.as_ptr(), data.len()) }
+}
+
+/// # Safety
+/// Privileged syscall path; copy helpers validate all user pointers.
+pub(super) unsafe fn sys_net_config(ptr: u64, write: u64) -> i64 {
+    // SAFETY: copyin/out validate buffers and config::apply serializes IO.
+    let result = unsafe {
+        match write {
+            0 => net::config::snapshot(None).and_then(|data| copyout(ptr, &data)),
+            2 => copyin::<4>(ptr).and_then(|index| net::config::snapshot(Some(u32::from_le_bytes(index) as usize))).and_then(|data| copyout(ptr, &data)),
+            1 => copyin::<{ net::config::CONFIG_SIZE }>(ptr).and_then(|data| net::config::apply(&data)),
+            _ => Err(Errno::Inval),
+        }
+    };
+    result.map_or_else(Errno::as_i64, |()| 0)
+}
+
+/// # Safety
+/// Privileged syscall path, no user pointers.
+pub(super) unsafe fn sys_udp_bind(port: u64) -> i64 {
+    if port == 0 || port > u16::MAX as u64 {
+        return Errno::Inval.as_i64();
+    }
+    // SAFETY: udp_bind serializes the bounded socket table.
+    unsafe { net::ownership::bind_udp(port as u16,proc::current_pid()).map_or_else(Errno::as_i64, |id| id as i64) }
+}
+
+/// # Safety
+/// Privileged syscall path; data length is bounded and pointers are copied.
+pub(super) unsafe fn sys_udp_sendto(ip: u64, port: u64, ptr: u64, len: u64) -> i64 {
+    if port == 0 || port > u16::MAX as u64 || len == 0 || len > 1024 || !user_ptr_ok(ptr, len) {
+        return Errno::Inval.as_i64();
+    }
+    // SAFETY: both user buffers are copied through page-validating helpers;
+    // the kernel payload is bounded to one small Ethernet datagram.
+    unsafe {
+        let ip = match copyin::<4>(ip) {
+            Ok(ip) => ip,
+            Err(error) => return error.as_i64(),
+        };
+        let mut data = [0; 1024];
+        if let Err(error) = vmm::copy_from_user(proc::current().root_pa, data.as_mut_ptr(), ptr, len as usize) {
+            return error.as_i64();
+        }
+        net::udp::udp_sendto(ip, port as u16, &data[..len as usize]).map_or_else(Errno::as_i64, |()| len as i64)
+    }
+}
+
+/// # Safety
+/// Privileged syscall path; sized kernel staging buffer prevents user faults.
+pub(super) unsafe fn sys_udp_recv(id: u64, ptr: u64, len: u64) -> i64 {
+    if id >= net::udp::MAX_UDP_SOCKS as u64 || len == 0 || len > 1024 || !user_ptr_ok(ptr, len) {
+        return Errno::Inval.as_i64();
+    }
+    // SAFETY: poll/recv serialize rings; copyout validates writable user pages.
+    unsafe {
+        let mut data = [0; 1024];
+        net::poll();
+        match net::ownership::udp(id as usize,proc::current_pid(),||net::udp::udp_recv(id as usize, &mut data[..len as usize])) {
+            Ok(n) => copyout(ptr, &data[..n]).map_or_else(Errno::as_i64, |()| n as i64),
+            Err(Errno::NoEnt) => 0,
+            Err(error) => error.as_i64(),
+        }
+    }
+}
+
+/// # Safety
+/// Privileged syscall path; socket index is checked before closing.
+pub(super) unsafe fn sys_udp_close(id: u64) -> i64 {
+    if id >= net::udp::MAX_UDP_SOCKS as u64 {
+        return Errno::Inval.as_i64();
+    }
+    // SAFETY: udp_close serializes the bounded slot table.
+    unsafe { net::ownership::udp(id as usize,proc::current_pid(),||{net::udp::udp_close(id as usize);Ok(())}).map_or_else(Errno::as_i64,|()|0) }
+}
diff --git a/kernel/src/syscall/net_server_sys.rs b/kernel/src/syscall/net_server_sys.rs
new file mode 100644
index 0000000..1294871
--- /dev/null
+++ b/kernel/src/syscall/net_server_sys.rs
@@ -0,0 +1,55 @@
+//! Privileged server socket operations for the bounded guest TCP/UDP stack.
+use super::handler::user_ptr_ok;
+use crate::{mm::vmm,net,proc};
+use onyx_core::errno::Errno;
+
+/// # Safety
+/// Syscall context. No user pointers; port is checked before conversion.
+pub(super) unsafe fn sys_net_listen(port:u64) -> i64 {
+    if port==0 || port>65535 {return Errno::Inval.as_i64();}
+    net::ownership::listen(port as u16,proc::current_pid()).map_or_else(Errno::as_i64,|id|id as i64)
+}
+/// # Safety
+/// Syscall context; accept is nonblocking after a bounded poll pass.
+pub(super) unsafe fn sys_net_accept(id:u64) -> i64 {
+    // SAFETY: net::poll serializes RX and accept validates the listener ID.
+    unsafe { net::poll(); }
+    net::ownership::listener(id as usize,proc::current_pid(),||net::tcp::listen::accept(id as usize)).map_or_else(Errno::as_i64,|cid|cid as i64)
+}
+/// # Safety
+/// Syscall context; the listener API validates the ID.
+pub(super) unsafe fn sys_net_unlisten(id:u64) -> i64 {
+    net::ownership::listener(id as usize,proc::current_pid(),||net::tcp::listen::close(id as usize)).map_or_else(Errno::as_i64,|()|0)
+}
+/// # Safety
+/// Syscall context; all user ranges are validated before dequeueing a datagram.
+pub(super) unsafe fn sys_udp_recvfrom(id:u64,ptr:u64,len:u64,peer:u64) -> i64 {
+    if id>=8 || len>1472 || !user_ptr_ok(ptr,len) || !user_ptr_ok(peer,8) {return Errno::Inval.as_i64();}
+    // SAFETY: writable pages checked first, copy helpers revalidate each page.
+    unsafe {
+        let root=proc::current().root_pa;
+        if vmm::check_user_range(root,ptr,len,true).is_err() || vmm::check_user_range(root,peer,8,true).is_err() {return Errno::Fault.as_i64();}
+        let mut buffer=[0;1472];net::poll();
+        match net::ownership::udp(id as usize,proc::current_pid(),||net::udp::udp_recv_from(id as usize,&mut buffer[..len as usize])) {
+            Ok((n,remote))=>{
+                let mut metadata=[0;8];metadata[..4].copy_from_slice(&remote.ip);
+                metadata[4..6].copy_from_slice(&remote.port.to_be_bytes());metadata[6]=remote.iface;
+                if vmm::copy_to_user(root,ptr,buffer.as_ptr(),n).is_err() || vmm::copy_to_user(root,peer,metadata.as_ptr(),8).is_err() {return Errno::Fault.as_i64();}
+                n as i64
+            },Err(error)=>error.as_i64(),
+        }
+    }
+}
+/// # Safety
+/// Syscall context; endpoint and bounded data copied from checked user pages.
+pub(super) unsafe fn sys_udp_sendfrom(id:u64,peer:u64,ptr:u64,len:u64) -> i64 {
+    if id>=8 || len>1472 || !user_ptr_ok(ptr,len) || !user_ptr_ok(peer,8) {return Errno::Inval.as_i64();}
+    // SAFETY: copy helpers validate each user page before reading.
+    unsafe {
+        let root=proc::current().root_pa;let mut metadata=[0;8];let mut data=[0;1472];
+        if vmm::copy_from_user(root,metadata.as_mut_ptr(),peer,8).is_err() || vmm::copy_from_user(root,data.as_mut_ptr(),ptr,len as usize).is_err() {return Errno::Fault.as_i64();}
+        let remote=net::udp::datagram::Peer {ip:metadata[..4].try_into().unwrap_or([0;4]),port:u16::from_be_bytes([metadata[4],metadata[5]]),iface:metadata[6]};
+        if remote.port==0 {return Errno::Inval.as_i64();}
+        net::ownership::udp(id as usize,proc::current_pid(),||net::udp::udp_send_from(id as usize,remote,&data[..len as usize])).map_or_else(Errno::as_i64,|()|len as i64)
+    }
+}
