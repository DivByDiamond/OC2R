 use onyx_core::errno::Errno;
 use onyx_core::fmt::Arg;
 
+fn resolve_open_path<'a>(
+    path: &'a [u8],
+    cwd: &[u8],
+    joined: &'a mut [u8; 512],
+) -> Option<&'a [u8]> {
+    if path.first() == Some(&b'/') {
+        return Some(path);
+    }
+    if path.is_empty() || cwd.first() != Some(&b'/') {
+        return None;
+    }
+
+    let separator = usize::from(cwd.last() != Some(&b'/'));
+    let len = cwd.len().checked_add(separator)?.checked_add(path.len())?;
+    if len > joined.len() {
+        return None;
+    }
+    joined[..cwd.len()].copy_from_slice(cwd);
+    let mut offset = cwd.len();
+    if separator != 0 {
+        joined[offset] = b'/';
+        offset += 1;
+    }
+    joined[offset..len].copy_from_slice(path);
+    Some(&joined[..len])
+}
