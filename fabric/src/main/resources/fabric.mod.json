{
  "schemaVersion": 1,
  "id": "oc2r",
  "version": "${version}",
  "name": "OC2R",
  "description": "Virtual computers with RISC-V emulation.",
  "license": "GPL-3.0-only",
  "environment": "*",
  "mixins": [
    "oc2r.fabric.mixins.json",
    "oc2r.fabric.shared-client.mixins.json",
    {
      "config": "oc2r.fabric.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "${access_widener}",
  "entrypoints": {
    "main": [
      "li.cil.oc2.fabric.OC2RFabric"
    ],
    "client": [
      "li.cil.oc2.fabric.OC2RFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
